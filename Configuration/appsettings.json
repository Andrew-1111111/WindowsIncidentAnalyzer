{
  "Database": {
    "Path": "data/investigation.db"
  },
  "Collection": {
    "DefaultHours": 24,
    "DefaultBatchSize": 500,
    "DefaultLimit": 100000,
    "EnableParallelCollection": true,
    "MaxDegreeOfParallelism": 0
  },
  "Analysis": {
    "EnableParallelAnalysis": true,
    "MaxDegreeOfParallelism": 0
  },
  "IocFeed": {
    "MaxDegreeOfParallelism": 0,
    "FeedTimeoutSeconds": 30
  },
  "Startup": {
    "AutoUpdateIocFeeds": true,
    "AutoUpdateSigmaRules": true,
    "IocRefreshHours": 6,
    "SigmaRefreshHours": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  }
}
